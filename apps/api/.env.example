# Backend-only configuration. Copy to .env and fill values locally.
# Never commit or paste populated values into chat. Do not load this blank template.

# Copy the PostgreSQL URL from Connect; URL-encode the database password.
# Use postgresql:// or postgresql+psycopg:// and the project's required TLS options.
DATABASE_URL=

# Use the same existing development project as the frontend.
SUPABASE_URL=
# Optional overrides; omit these lines to derive URLs from SUPABASE_URL.
# Typical hosted issuer: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Typical hosted JWKS: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Privileged backend-only service_role/secret key, never a JWT signing secret.
SUPABASE_SERVICE_ROLE_KEY=

# CORS allows these explicit origins and the Authorization header.
ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
LOG_LEVEL=INFO
