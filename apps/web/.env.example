# Public browser configuration only. Copy to .env.local and fill values locally.
# Never put database credentials, service-role/secret keys, or access tokens here.
VITE_API_BASE_URL=http://localhost:8000

# Use the existing development project's URL and public anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
